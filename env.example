# FounderBlaze — Python A2MCP (FastAPI + Temporal + Genblaze)
PORT=4021
PUBLIC_API_BASE_URL=http://localhost:4021

# Agent FastAPI (apps/agent) + CORS for Next.js chat (apps/chat)
AGENT_PORT=4022
FOUNDERBLAZE_A2MCP_BASE_URL=http://localhost:4021
AGENT_CORS_ORIGINS=http://localhost:3001
# AGENT_JOB_TIMEOUT_SECONDS=1800
# Agent chat/tool-loop (defaults to Gemini 3.1 Pro). Services use GEMINI_TEXT_MODEL.
AGENT_GEMINI_MODEL=gemini-3.1-pro-preview

# Durable job store (required for api/worker; optional for agent/MCP)
# Matches infra/docker/docker-compose.smoke.yml (Postgres on 5433).
# Or use docker-compose.python.yml with founderblaze/founderblaze credentials.
DATABASE_URL=postgres://founderforge:founderforge@localhost:5433/founderforge

# Temporal (required for job execution)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=founderblaze
# Temporal Cloud only:
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=true

# Backblaze B2 — APD / brand-kit / outreach / social-listening / promo-video artifacts (genblaze-s3 ObjectStorageSink)
# From B2 app key UI: keyID → B2_KEY_ID, applicationKey → B2_APP_KEY (not keyName)
# From bucket UI: bucket name → B2_BUCKET; endpoint s3.<region>.backblazeb2.com → B2_REGION
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-east-005
# Private buckets: leave empty (presigned GET). Public friendly URL base only if bucket is public.
B2_PUBLIC_URL_BASE=
B2_URL_TTL_SECONDS=604800

# Google Gemini (APD / brand-kit / outreach / social-listening / promo-video LLM)
# Promo-video Google Search grounding needs a capable model (2.5 Flash/Pro/Lite or 3.x).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Segmind Seedance 2.0 (promo-video). Defaults: duration 10s @ 720p.
SEGMIND_API_KEY=
# Optional / unused by promo-video after Seedance swap:
# VEO_MODEL=veo-3.1-generate-preview
# Optional pacing between brand-kit image calls (ms)
BRANDKIT_STEP_DELAY_MS=3000

# Exa (outreach website contents + investor/portfolio/contact research)
EXA_SEARCH_API_KEY=
# Alias accepted by outreach runtime:
# EXA_API_KEY=

# Tavily (social-listening Reddit Research)
TAVILY_API_KEY=
TAVILY_REDDIT_MODE=research
TAVILY_RESEARCH_MODEL=mini
# Optional scrape fallback for product pages / competitor evidence:
JINA_API_KEY=

# Competitor research web search (Serper → Brave → DuckDuckGo failover)
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Automated product demo vendors
FIRECRAWL_API_KEY=
LMNT_API_KEY=
LMNT_VOICE=lily
